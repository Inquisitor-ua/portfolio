# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# --- Django ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=yehor-inq.com,www.yehor-inq.com
CSRF_TRUSTED_ORIGINS=https://yehor-inq.com,https://www.yehor-inq.com
WAGTAILADMIN_BASE_URL=https://yehor-inq.com
TIME_ZONE=UTC

# Set to 1 once certbot has issued a certificate and host nginx redirects to
# https (see deploy/nginx/yehor-inq.com.conf).
SECURE_SSL_ENABLED=1

# --- Database (docker-compose.yml builds DATABASE_URL from these) -----------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# --- Error reporting -----------------------------------------------------------
ADMIN_EMAILS=

# --- Optional: create a superuser automatically on first boot ----------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Optional: Redis cache ----------------------------------------------------
REDIS_URL=

# --- Email (defaults to the console backend if left blank) -------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@localhost
